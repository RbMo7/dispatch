node_modules/
dist/
.env
.env.backup-*
*.log
.DS_Store

# Auto-provisioned devnet test wallet/mint (solana-chain-handler tests, ADR-0013)
# — regenerated and re-funded per machine, never committed.
.devnet-fixtures/

# Auto-deployed Base Sepolia test-token address (base-chain-handler tests, ADR-0013)
# — persists on-chain forever once deployed, cached here so re-running the
# suite doesn't redeploy (and re-spend real Base Sepolia ETH) every time.
.base-fixtures/

# A deployment's own senders file (ADR-0060) may hold a Safe API key; senders.example.json is the template.
senders.json
senders.json.backup-*

# What Compose mounts into the api and worker (docker-compose.yml) is a deployment's own; only the README is committed.
/config/*
!/config/README.md
