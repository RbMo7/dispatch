{
  "address": "EcqsVLKPa1uuNG1Rs6tj2t8aGj1bAYgEwJszGHmpbo7x",
  "metadata": {
    "name": "internal_asset",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "Created with Anchor"
  },
  "docs": [
    "A minimal internal asset ledger: balances live entirely in this",
    "program's own PDA-owned accounts, never touching SPL Token — a",
    "deliberately custom, novel-to-any-caller asset, to exercise a",
    "generic engine's \"opaque contract call\" path against something it",
    "has never seen before."
  ],
  "instructions": [
    {
      "name": "initialize_asset",
      "docs": [
        "Creates the PDA balance account for `owner` and credits it with",
        "`initial_balance` units — the internal-asset equivalent of a mint."
      ],
      "discriminator": [
        214,
        153,
        49,
        248,
        95,
        248,
        208,
        179
      ],
      "accounts": [
        {
          "name": "asset_account",
          "writable": true,
          "pda": {
            "seeds": [
              {
                "kind": "const",
                "value": [
                  97,
                  115,
                  115,
                  101,
                  116
                ]
              },
              {
                "kind": "account",
                "path": "owner"
              }
            ]
          }
        },
        {
          "name": "owner",
          "docs": [
            "owner's own signature isn't required to be minted a balance,",
            "only to later spend from it (see `TransferAsset`)."
          ]
        },
        {
          "name": "payer",
          "writable": true,
          "signer": true
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": [
        {
          "name": "initial_balance",
          "type": "u64"
        }
      ]
    },
    {
      "name": "transfer_asset",
      "docs": [
        "Moves `amount` units from `owner`'s balance to `to_owner`'s —",
        "requires `owner`'s signature, never `to_owner`'s."
      ],
      "discriminator": [
        126,
        66,
        109,
        18,
        60,
        172,
        131,
        124
      ],
      "accounts": [
        {
          "name": "from",
          "writable": true,
          "pda": {
            "seeds": [
              {
                "kind": "const",
                "value": [
                  97,
                  115,
                  115,
                  101,
                  116
                ]
              },
              {
                "kind": "account",
                "path": "owner"
              }
            ]
          }
        },
        {
          "name": "owner",
          "signer": true,
          "relations": [
            "from"
          ]
        },
        {
          "name": "to",
          "writable": true,
          "pda": {
            "seeds": [
              {
                "kind": "const",
                "value": [
                  97,
                  115,
                  115,
                  101,
                  116
                ]
              },
              {
                "kind": "account",
                "path": "to_owner"
              }
            ]
          }
        },
        {
          "name": "to_owner"
        }
      ],
      "args": [
        {
          "name": "amount",
          "type": "u64"
        }
      ]
    }
  ],
  "accounts": [
    {
      "name": "AssetAccount",
      "discriminator": [
        232,
        116,
        193,
        133,
        166,
        100,
        217,
        39
      ]
    }
  ],
  "errors": [
    {
      "code": 6000,
      "name": "InsufficientBalance",
      "msg": "insufficient internal asset balance"
    }
  ],
  "types": [
    {
      "name": "AssetAccount",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "owner",
            "type": "pubkey"
          },
          {
            "name": "balance",
            "type": "u64"
          }
        ]
      }
    }
  ]
}