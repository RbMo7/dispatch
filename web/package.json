{
  "name": "web",
  "version": "0.1.0",
  "description": "The console, docs site and landing page. One codebase, two builds: engine (served by the API) and public (static hosting).",
  "type": "module",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --mode engine",
    "dev:public": "vite --mode public",
    "build": "vite build --mode engine && vite build --mode public",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-contrast.ts && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.14.24",
    "minisearch": "^7.2.0",
    "motion": "^14.9.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.6",
    "hast-util-to-string": "^3.0.1",
    "jsdom": "^30.1.3",
    "read-excel-file": "^9.3.14",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.5",
    "vitest": "^3.2.7"
  }
}
