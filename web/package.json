{
  "name": "web",
  "version": "0.1.0",
  "description": "The console, docs site and landing page. One codebase, two builds: engine (served by the API) and public (static hosting).",
  "type": "module",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --mode engine",
    "dev:public": "vite --mode public",
    "build": "vite build --mode engine && vite build --mode public",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-contrast.ts && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^14.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.7"
  }
}
