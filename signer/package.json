{
  "name": "signer",
  "version": "0.1.0",
  "description": "The Signer: holds each Sender's key in a backend chosen per address, behind the engine's /sign contract (ADR-0002, ADR-0046). A standalone service the engine never imports.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "SIGNER_CONFIG=signer.config.dev.json SIGNER_KEYFILE=keys.dev.json tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1146.0",
    "@noble/curves": "^2.4.0",
    "@privy-io/node": "^0.35.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "viem": "^2.56.9"
  }
}
