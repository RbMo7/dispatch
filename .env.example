PORT=8420
DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch
SIGNER_URL=http://localhost:8421
# Bearer token for every /sign request (ADR-0046); must match the Signer's own SIGNER_AUTH_TOKEN.
SIGNER_AUTH_TOKEN=
ENABLED_CHAINS=solana
AUTH_TOKEN=dev-secret

# Solana Chain Handler config (only consulted when 'solana' is in ENABLED_CHAINS)
SOLANA_RPC_URL=https://api.devnet.solana.com
# The dev Signer (signer/signer.config.dev.json) signs for 3fJt3SpG7iWcYfo2MnP8b1LaP3eBhzZ57zHBxWSPWoZe.
SOLANA_SENDER_ADDRESS=
# Comma-separated SYMBOL:mint:decimals; append :token-2022 for a Token-2022 mint (e.g. PYUSD).
SOLANA_KNOWN_TOKENS=
# Priority fee (micro-lamports per compute unit) on every transaction the engine builds.
# 0 or empty adds none: it costs more, so it's opt-in (ADR-0003). Needed on a congested mainnet.
# When set, each transaction's compute-unit limit is set from a simulation, so the fee is paid on real usage.
# `auto` prices each transaction from recent network fees (75th percentile), never above the max below.
SOLANA_COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=
SOLANA_MAX_COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=
# How many Solana transactions one worker sends at once (no nonces to keep in order). Default 4.
SOLANA_SEND_CONCURRENCY=

# Base Chain Handler config (only consulted when 'base' is in ENABLED_CHAINS)
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
# The dev Signer (signer/signer.config.dev.json) signs for 0x7499BC37AcA4f0F4a7A982Afdfea340AfDd74e6A.
BASE_SENDER_ADDRESS=
BASE_KNOWN_TOKENS=
BASE_FEE_BUMP_PERCENT=15
BASE_STUCK_AFTER_MS=60000
BASE_MAX_FEE_BUMPS=5
BASE_BULK_CALL_MAX_BATCH_SIZE=50
# A tracing-capable Base RPC (debug_traceTransaction) — required for Bulk Call; empty disables it.
BASE_TRACE_RPC_URL=

# Tests only (`pnpm test`, the live-chain tier): RPCs for the dev wallets'
# real test networks. Public endpoints are the fallback, but they rate-limit.
SOLANA_DEVNET_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# Set to 1 to run the opt-in Base Sepolia volume run (ADR-0040) — spends testnet ETH.
RUN_BASE_VOLUME=
# Set to 1 to run the opt-in Solana devnet volume run (500 payments, ~0.55 devnet SOL).
RUN_SOLANA_VOLUME=
# Set to 1 to run the opt-in Privy live test (src/signer/privy-e2e.test.ts): Privy wallets
# signing through the Signer on Base Sepolia and devnet. It needs an operator's Privy app,
# its authorization key, and an Ethereum and a Solana wallet both owned by that key.
RUN_PRIVY=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
PRIVY_BASE_WALLET_ID=
PRIVY_SOLANA_WALLET_ID=
