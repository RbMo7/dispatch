PORT=8420
DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch
SIGNER_URL=http://localhost:8421
ENABLED_CHAINS=solana
AUTH_TOKEN=dev-secret

# Solana Chain Handler config (only consulted when 'solana' is in ENABLED_CHAINS)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SENDER_ADDRESS=
SOLANA_KNOWN_TOKENS=

# Base Chain Handler config (only consulted when 'base' is in ENABLED_CHAINS)
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
BASE_SENDER_ADDRESS=
BASE_KNOWN_TOKENS=
BASE_FEE_BUMP_PERCENT=15
BASE_STUCK_AFTER_MS=60000
BASE_MAX_FEE_BUMPS=5
BASE_BULK_CALL_MAX_BATCH_SIZE=50
# A tracing-capable Base RPC (debug_traceTransaction) — required for Bulk Call; empty disables it.
BASE_TRACE_RPC_URL=

# Tests only (`pnpm test`, the live-chain tier): RPCs for the dev wallets'
# real test networks. Public endpoints are the fallback, but they rate-limit.
SOLANA_DEVNET_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# Set to 1 to run the opt-in Base Sepolia volume run (ADR-0040) — spends testnet ETH.
RUN_BASE_VOLUME=
