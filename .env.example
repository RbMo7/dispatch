PORT=8420
DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch
# Worker only: the API never calls the Signer (ADR-0059), so leave both unset in the API's environment.
SIGNER_URL=http://localhost:8421
# Bearer token for every /sign request (ADR-0046); must match the Signer's own SIGNER_AUTH_TOKEN.
SIGNER_AUTH_TOKEN=
ENABLED_CHAINS=solana
AUTH_TOKEN=dev-secret
# Several named Senders per chain (ADR-0060): a JSON file naming each chain's Senders, each with its own
# mode (single, squads or safe) and keys, and an optional per-chain default. See senders.example.json.
# Unset: senders.json if it exists. Without a senders file, the SOLANA_* and BASE_* Sender variables
# below describe one Sender per chain, named `default`, and every request without `sender` pays from it.
# With one, those Sender variables are ignored (BASE_SAFE_API_KEY still applies to a Safe Sender that
# names no apiKey of its own).
SENDERS_FILE=

# Solana Chain Handler config (only consulted when 'solana' is in ENABLED_CHAINS)
SOLANA_RPC_URL=https://api.devnet.solana.com
# The dev Signer (signer/signer.config.dev.json) signs for 3fJt3SpG7iWcYfo2MnP8b1LaP3eBhzZ57zHBxWSPWoZe.
SOLANA_SENDER_ADDRESS=
# Multisig Sender (ADR-0049): pay from a Squads v4 multisig's vault. Its Approvers approve each proposal in
# Squads; the engine only proposes and executes, from an ordinary key that holds exactly Initiate + Execute
# (permission mask 5) and never Vote. Off by default.
# `single` (default): SOLANA_SENDER_ADDRESS pays directly. `multisig`: payments come from the vault of
# SOLANA_MULTISIG_ADDRESS (vault index 0); SOLANA_SENDER_ADDRESS may be left empty, and if set must equal it.
SOLANA_SENDER_MODE=single
# The Squads multisig account (not its vault).
SOLANA_MULTISIG_ADDRESS=
# The engine's own key: proposes, executes and pays fees. The Signer must hold it. Set it as the multisig's
# rent collector too, or the rent paid per proposal can never be reclaimed.
SOLANA_MULTISIG_MEMBER_ADDRESS=
# How long a proposal may wait for approval before its Calls are ABANDONED (ADR-0053). Default 72h.
SOLANA_APPROVAL_DEADLINE_MS=259200000
# How long an abandoned proposal is still watched for a late execution. Default 30 days.
SOLANA_APPROVAL_REWATCH_WINDOW_MS=2592000000
# Comma-separated SYMBOL:mint:decimals; append :token-2022 for a Token-2022 mint (e.g. PYUSD).
SOLANA_KNOWN_TOKENS=
# Priority fee (micro-lamports per compute unit) on every transaction the engine builds.
# 0 or empty adds none: it costs more, so it's opt-in (ADR-0003). Needed on a congested mainnet.
# When set, each transaction's compute-unit limit is set from a simulation, so the fee is paid on real usage.
# `auto` prices each transaction from recent network fees (75th percentile), never above the max below.
SOLANA_COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=
SOLANA_MAX_COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=
# How many Solana transactions one worker sends at once per Sender (no nonces to keep in order). Default 4.
SOLANA_SEND_CONCURRENCY=

# Base Chain Handler config (only consulted when 'base' is in ENABLED_CHAINS)
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
# The dev Signer (signer/signer.config.dev.json) signs for 0x7499BC37AcA4f0F4a7A982Afdfea340AfDd74e6A.
BASE_SENDER_ADDRESS=
BASE_KNOWN_TOKENS=
BASE_FEE_BUMP_PERCENT=15
BASE_STUCK_AFTER_MS=60000
BASE_MAX_FEE_BUMPS=5
BASE_BULK_CALL_MAX_BATCH_SIZE=50
# A tracing-capable Base RPC (debug_traceTransaction) — required for Bulk Call; empty disables it.
BASE_TRACE_RPC_URL=

# Safe Sender (ADR-0051): pay from a Safe multisig. Its owners approve each proposal in the Safe app;
# the engine only proposes (as a registered delegate) and executes (from an ordinary key). Off by default.
# `single` (default): BASE_SENDER_ADDRESS pays directly. `safe`: payments come from BASE_SAFE_ADDRESS.
BASE_SENDER_MODE=single
# The Safe (Safe 1.3.0 or 1.4.1) the payments come from.
BASE_SAFE_ADDRESS=
# The engine's own key: submits execTransaction, pays gas, owns the nonce. It must NOT be an owner, and an
# owner must register it as a delegate (see the startup message). It is the Sender, so BASE_SENDER_ADDRESS
# may be left empty; if set, it must equal this.
BASE_SAFE_EXECUTOR_ADDRESS=
# Safe Transaction Service. Default: https://api.safe.global/tx-service/base (8453) or .../basesep (84532).
BASE_SAFE_TX_SERVICE_URL=
# Optional API key (developer.safe.global), sent as a bearer token. Without one the hosted service allows
# only 2 requests/second and 5,000/month, and the engine warns at startup. Never logged.
BASE_SAFE_API_KEY=
# How long a proposal may wait for approval before its Calls are ABANDONED (ADR-0053). Default 72h.
BASE_APPROVAL_DEADLINE_MS=259200000
# How long an abandoned proposal is still watched for a late execution. Default 30 days.
BASE_APPROVAL_REWATCH_WINDOW_MS=2592000000
# The most payments in one Safe proposal (one MultiSend). A bigger Dispatch becomes several proposals,
# approved one after another. Default 50; the maximum is 300.
BASE_SAFE_BUNDLE_LIMIT=

# Tests only (`pnpm test`, the live-chain tier): RPCs for the dev wallets'
# real test networks. Public endpoints are the fallback, but they rate-limit.
SOLANA_DEVNET_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# Set to 1 to run the opt-in Base Sepolia volume run (ADR-0040) — spends testnet ETH.
RUN_BASE_VOLUME=
# Set to 1 to run the opt-in Solana devnet volume run (500 payments, ~0.55 devnet SOL).
RUN_SOLANA_VOLUME=
# Set to 1 to run the opt-in Privy live test (src/signer/privy-e2e.test.ts): Privy wallets
# signing through the Signer on Base Sepolia and devnet. It needs an operator's Privy app,
# its authorization key, and an Ethereum and a Solana wallet both owned by that key.
RUN_PRIVY=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
PRIVY_BASE_WALLET_ID=
PRIVY_SOLANA_WALLET_ID=
# Set to 1 to run the opt-in AWS KMS live test (src/signer/aws-kms-e2e.test.ts): a KMS key
# signing a Base Sepolia transfer through the Signer. AWS_KMS_KEY_ID is the key's id or ARN
# (KeySpec ECC_SECG_P256K1, KeyUsage SIGN_VERIFY); region and credentials come from the AWS
# SDK's standard provider chain (AWS_REGION plus AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, or AWS_PROFILE).
# AWS_KMS_ED25519_KEY_ID, optional, adds a Solana devnet transfer signed by a second KMS key
# (KeySpec ECC_NIST_EDWARDS25519, KeyUsage SIGN_VERIFY); that case is skipped when it is unset.
RUN_AWS_KMS=
AWS_KMS_KEY_ID=
AWS_KMS_ED25519_KEY_ID=
# Set to 1 to run the opt-in local-backend live test (src/signer/local-e2e.test.ts): fresh keys in a
# temporary encrypted keystore sign a Base Sepolia and a Solana devnet transfer through the Signer.
# It needs no keys of its own; each is topped up from the dev Senders.
RUN_LOCAL_SIGNER=
# Set to 1 to run the opt-in Squads live test (src/chain-handler/solana/multisig/squads-engine-e2e.test.ts):
# the whole engine (API, Postgres, Coordinator, a real Signer) against a throwaway devnet 2-of-3 Squads
# multisig: approve, reject, timeout then a late human execution, Funding Check, Signer policy. It spends
# devnet SOL from the cached dev sender (capped at 0.15 SOL, never below 5 SOL on that wallet).
# SQUADS_E2E_KEYS_DIR is a directory with public.json and member/voter1-3/human keypair files (never committed).
RUN_SQUADS=
SQUADS_E2E_KEYS_DIR=

# Set to 1 to run the opt-in Safe Multisig Sender end-to-end test (src/chain-handler/base/safe/safe-engine-e2e.test.ts):
# the whole engine against Base Sepolia and the hosted Safe Transaction Service (unauthenticated: 2 requests a second,
# 5,000 a month; a run uses a few hundred). Needs SAFE_E2E_KEYS_FILE, a JSON file {"o1","o2","o3","engine"} of 0x
# private keys: the three owners of a funded 2-of-3 Safe and its registered delegate (the executor, not an owner).
# SAFE_E2E_SAFE and SAFE_E2E_TOKEN override the spike's Safe and test token. Spends a little gas, nothing else.
RUN_SAFE=
SAFE_E2E_KEYS_FILE=
SAFE_E2E_SAFE=
SAFE_E2E_TOKEN=
